# ==============================================================================
# BIS Intelligent Assistant - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env

FLASK_APP=app.factory:create_app

DEBUG=false
HOST=0.0.0.0
PORT=5000

LOG_LEVEL=INFO
ENVIRONMENT=development

# ==============================================================================
# AI Provider & Model Configuration
# ==============================================================================
# OLLAMA (production/local) | FAKE (CI and isolated unit testing)
AI_PROVIDER=OLLAMA

# Model server URL:
# - Google Colab / Kaggle via Cloudflare Tunnel: https://<your-tunnel>.trycloudflare.com
# - Local Ollama on host: http://localhost:11434
# - Inside Docker accessing host Ollama: http://host.docker.internal:11434
MODEL_URL=https://<your-tunnel>.trycloudflare.com

# Target Ollama model name (e.g., qwen3:8b, qwen2.5:7b)
MODEL_NAME=qwen3:8b

# ==============================================================================
# Embeddings
# ==============================================================================
EMBEDDINGS_MODEL=all-MiniLM-L6-v2
# EMBEDDINGS_DEVICE=cpu # 'cuda', 'cpu', or omitted for auto-detection

# ==============================================================================
# PostgreSQL & pgvector Database Settings
# ==============================================================================
# For local development / running outside Docker:
POSTGRES_HOST=127.0.0.1
# For running inside Docker container: set POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bis_assistant

SQLALCHEMY_TRACK_MODIFICATIONS=false
HNSW_EF_SEARCH=100

# ==============================================================================
# Retrieval & Multi-Hop Planner Settings
# ==============================================================================
MIN_SIMILARITY=0.4
MAX_LIMIT=100
MAX_RETRIEVAL_HOPS=3
DEFAULT_RAG_TOP_K=5
DEFAULT_DB_LIMIT=10
SEMANTIC_DB_SIMILARITY_THRESHOLD=0.40
MAX_EVIDENCE_COUNT=25
CLARIFICATION_THRESHOLD=3

# ==============================================================================
# Rate Limiting & File Uploads
# ==============================================================================
MAX_CONTENT_LENGTH=10485760
UPLOAD_FOLDER=file_uploads

RATELIMIT_ENABLED=true
DEFAULT_GLOBAL_LIMIT=["200 per day","50 per hour"]
LIMITER_STORAGE_URI=memory://
LIMITER_STRATEGY=fixed-window
RATELIMIT_HEADERS_ENABLED=true
QUERY_RATE_LIMIT=15 per minute
